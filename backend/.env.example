# Aegis-V2X backend configuration
DATABASE_URL=postgresql+psycopg2://aegis:aegis@localhost:5432/aegis_v2x
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:8000

# Optional: gate write endpoints (POST/PATCH) behind an X-API-Key header.
# Leave unset for unauthenticated local dev (default, matches existing
# behavior). Set this before exposing the backend beyond localhost, e.g.
# via the VS Code Dev Tunnel used for the Lovable dashboard preview.
# API_KEY=
